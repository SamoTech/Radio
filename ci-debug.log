    const MAX_IP_SESSIONS = 2;
    const MAX_RECEIVER_SESSIONS = 2;
    const MAX_SESSIONS = 32;
    const SESSION_MS = 30 * 60 * 1000;
    const MAX_CLIENT_BYTES = 4096;
    const MAX_UPSTREAM_BYTES = 65536;
